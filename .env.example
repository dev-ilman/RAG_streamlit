# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Security ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set to true when serving over HTTPS (required for the refresh cookie in prod).
COOKIE_SECURE=false

# --- Database ---------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Overrides the parts above if set. Must use the asyncpg driver.
# DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag

# --- Model provider ---------------------------------------------------------
# "gemini" for real inference, "fake" for deterministic offline/CI behaviour.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Must match the vector column width created by the migration.
# Changing this requires a new migration (see docs/architecture.md).
EMBEDDING_DIM=768

# --- Retrieval / ingestion --------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
MAX_UPLOAD_BYTES=10485760

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
STORAGE_DIR=/app/data/uploads
RATE_LIMIT_PER_MINUTE=60
